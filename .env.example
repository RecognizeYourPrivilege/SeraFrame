# Required. The process exits if this is missing or empty. There is no default.
SERAFRAME_ADMIN_PASSWORD=change-me

# Optional. At least 32 bytes.
# Leave unset to generate $SERAFRAME_DATA_DIR/secret_key on first start and reuse it.
# If set, that value is used and the persisted file is not created or overwritten.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SERAFRAME_SECRET_KEY=

SERAFRAME_TRUST_PROXY=0
